<mujoco model="falling_robot">
  <option timestep="0.002" gravity="0 0 -9.81"/>
  <worldbody>
    <body name="floor_body" pos="0 0 0">
      <geom name="floor" type="plane" size="5 5 0.1"/>
    </body>
    <body name="torso" pos="0 0 0.05">
      <joint name="torso_free" type="free"/>
      <geom name="torso_geom" type="box" size="0.2 0.1 0.05" mass="5.0"/>
      <body name="foot" pos="0 0 -0.5">
        <joint name="foot_hinge" type="hinge" axis="0 1 0"/>
        <geom name="foot_geom" type="box" size="0.1 0.05 0.02" mass="0.5"/>
      </body>
    </body>
  </worldbody>
</mujoco>
